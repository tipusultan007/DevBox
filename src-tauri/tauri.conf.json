{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevBox",
  "version": "0.1.0",
  "identifier": "com.devbox.app",
  "build": {
    "beforeDevCommand": "npm --workspace=apps/desktop run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --workspace=apps/desktop run build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevBox — Windows PHP Development Environment",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://localhost:* https://*.trycloudflare.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Complete PHP/Windows local development environment",
    "longDescription": "DevBox is a local development environment for Windows with per-project PHP runtimes, automatic domains, SSL, database manager, and Cloudflare sharing.",
    "resources": [
      "../runtime/manifests/**/*",
      "../scripts/**/*",
      "migrations/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
